<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_turno"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="?attr/selectableItemBackground">

    <!-- Columna Horario -->
    <TextView
        android:id="@+id/tv_hora"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center_vertical"
        android:lineSpacingExtra="2dp" />

    <!-- Contenedor Central -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">

        <TextView
            android:id="@+id/tv_nombre_paciente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Fila de Badges: Ajustado espacio y desactivado recortes del contenedor -->
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:chipSpacingVertical="8dp"
            app:chipSpacingHorizontal="4dp">

            <TextView
                android:id="@+id/tv_obra_social_turno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_tipo_cobertura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="2dp"
                android:gravity="center"
                android:background="@drawable/bg_badge_cud" />

            <TextView
                android:id="@+id/tv_modalidad_turno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="2dp"
                android:gravity="center"
                android:background="@drawable/bg_badge_particular"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_sesiones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="4dp"
                android:layout_marginBottom="2dp"
                android:gravity="center"
                android:background="@drawable/bg_badge_orden"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_diagnostico_turno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <!-- Columna Acción -->
    <ImageView
        android:id="@+id/cb_atendido"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_checkbox_unchecked"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Atendido" />

    <ImageView
        android:id="@+id/iv_menu_turno"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_more_vert_white"
        android:tint="@color/text_secondary"
        android:visibility="gone"
        android:contentDescription="Opciones" />

</LinearLayout>
